export EDITOR="nvim"
export GPG_TTY=$(tty)
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export FUNCTIONS_CORE_TOOLS_TELEMETRY_OPTOUT=1

alias reload="source ~/.dotfilesrc && echo 'Reloaded run commands' || echo 'Failed'"
alias gitmoji-cli="pnpm dlx gitmoji-cli"
alias commit="pnpm dlx gitmoji-cli -c"
alias cm="commit"
alias nx="pnpm dlx nx"
# NOTE: The devcontainer CLI exits silently with a non-zero status when Docker is unavailable,
#       because its `exec` handler suppresses any error that carries an exit code (missing
#       `docker` binary, unreachable daemon, etc.). Check Docker explicitly so the failure is
#       loud instead of looking like the command did nothing.
function dcon() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "dcon: 'docker' not found on PATH. Install Docker (Engine on Linux/WSL2, Docker Desktop on macOS) and try again." >&2
    return 1
  fi
  if ! docker info >/dev/null 2>&1; then
    if ! id -nG 2>/dev/null | tr ' ' '\n' | grep -qx docker; then
      echo 'dcon: cannot reach the Docker daemon - this session has no docker group (socket permission denied). Run "su - $USER" or restart WSL ("wsl --shutdown"), then retry.' >&2
    else
      echo "dcon: Docker is installed but the daemon is not reachable. Start Docker (e.g. 'sudo systemctl start docker', or launch Docker Desktop) and try again." >&2
    fi
    return 1
  fi
  pnpm dlx @devcontainers/cli "$@"
}
alias conf="confluence"

function confluence() {
  pnpm dlx confluence-cli "$@"
}

# AI CLI Commands:
function copilot() {
  pnpm dlx @github/copilot "$@"
}

function gemini() {
  pnpm dlx @google/gemini-cli "$@"
}

alias cop='copilot'
alias gem='gemini'
alias jules="pnpm dlx @google/jules"
alias ask="llm -m fast -t cli-response"
alias chat="llm chat -m code"
